# Required for Groq chat and optional PDF image captioning
GROQ_API_KEY=your_groq_api_key_here

# Optional; defaults to qwen/qwen3.8-27b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Optional; set only when Tesseract is installed outside PATH
# TESSERACT_PATH=/path/to/tesseract

# Optional paths (defaults are relative to this project)
# RAG_DOCS_PATH=docs
# CHROMA_DB_PATH=db/chroma_db
